# Postgres (matches docker-compose.yml — note port 5433, remapped because a
# system-installed Postgres was already using the default 5432)
DATABASE_URL="postgresql://socialstudio:socialstudio@localhost:5433/socialstudio?schema=public"

# Redis (for BullMQ, added in Phase 4)
REDIS_URL="redis://localhost:6379"

PORT=3000

# Fake platform server (Phase 3)
FAKE_PLATFORM_PORT=4000
FAKE_PLATFORM_CALLBACK_URL=http://localhost:3000/webhook/social-delivery
WEBHOOK_SECRET=dev-secret-change-me